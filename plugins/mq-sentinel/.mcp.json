{
  "mcpServers": {
    "mq-sentinel": {
      "command": "uvx",
      "args": ["--from", "${MQS_PACKAGE:-mq-sentinel==0.5.0}", "mq-sentinel", "serve"],
      "env": {
        "MQS_AUTH_DISABLE_AUTH_FOR_LOCAL_DEV": "${MQS_AUTH_DISABLE_AUTH_FOR_LOCAL_DEV:-true}",
        "MQS_SERVER_ENVIRONMENT": "${MQS_SERVER_ENVIRONMENT:-dev}",
        "MQS_SERVER_CONNECTOR": "${MQS_SERVER_CONNECTOR:-auto}",
        "MQS_SERVER_INVENTORY_DIR": "${MQS_SERVER_INVENTORY_DIR:-}",
        "MQS_SERVER_SECRETS_DIR": "${MQS_SERVER_SECRETS_DIR:-}",
        "MQS_AUDIT_LOG_PATH": "${HOME}/.mq-sentinel/audit.jsonl"
      }
    }
  }
}
