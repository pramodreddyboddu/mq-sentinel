{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "MQ-Sentinel - Enterprise Overview",
  "tags": ["mq", "mcp", "observability", "enterprise"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Request Rate",
      "type": "graph",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(mq_sentinel_requests_total[5m])",
          "legendFormat": "{{tool}}"
        }
      ],
      "yaxes": [
        { "format": "reqps" }
      ]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(mq_sentinel_errors_total[5m])",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "title": "Active Principals (last 5m)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(increase(mq_sentinel_requests_total[5m])) by (principal)"
        }
      ]
    },
    {
      "title": "Audit Log Write Rate",
      "type": "graph",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(mq_sentinel_audit_writes_total[5m])"
        }
      ]
    },
    {
      "title": "Health Check Status",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "mq_sentinel_health_status"
        }
      ],
      "thresholds": [
        { "color": "green", "value": 1 },
        { "color": "red", "value": 0 }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(mq_sentinel_requests_total, environment)",
        "includeAll": true
      }
    ]
  }
}