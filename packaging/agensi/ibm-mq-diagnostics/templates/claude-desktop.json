{
  "mcpServers": {
    "mq-sentinel": {
      "command": "uvx",
      "args": ["mq-sentinel=={{VERSION}}", "serve"],
      "env": {
        "MQS_SERVER_ENVIRONMENT": "dev",
        "MQS_AUTH_DISABLE_AUTH_FOR_LOCAL_DEV": "true",
        "MQS_AUDIT_LOG_PATH": "/ABSOLUTE/PATH/TO/HOME/.mq-sentinel/audit.jsonl"
      }
    }
  }
}
